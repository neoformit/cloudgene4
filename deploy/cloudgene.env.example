# Cloudgene production environment file (SPEC §3.2). Copy to /etc/cloudgene/cloudgene.env,
# fill in real values, `chmod 600` it (it holds the DB password), and reference it from
# EnvironmentFile= in the systemd units in this directory. Every variable the app reads is
# listed below (grepped from os.environ across the codebase); nothing else is read from the
# process environment.
#
# This example is exercised by `manage.py check --deploy` in CI/by the T09a smoke test — keep
# it clean (no warnings) when you add a variable.

# --- Core Django ---
DEBUG=False
# Required in production: a long random value. Leave unset in dev to use the auto-generated
# $CLOUDGENE_HOME/config/secret_key instead (shared by web + worker; do not do this in prod
# behind a load balancer with more than one host — set DJANGO_SECRET_KEY explicitly so all
# hosts agree).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REPLACE-ME-WITH-A-LONG-RANDOM-VALUE-AT-LEAST-50-CHARACTERS-abcdefgh
ALLOWED_HOSTS=cloudgene.example.org
CSRF_TRUSTED_ORIGINS=https://cloudgene.example.org

# --- Database (SPEC §3.1: Postgres is the production database) ---
DATABASE_URL=postgres://cloudgene:change-me@127.0.0.1:5432/cloudgene
DB_CONN_MAX_AGE=60

# --- Cloudgene data/config directory (SPEC §3.2) ---
CLOUDGENE_HOME=/var/lib/cloudgene

# --- Logging (SPEC §3.8) ---
LOG_LEVEL=INFO
# "json" for journald/log shippers; unset (or "standard") for human-readable text.
LOG_FORMAT=json

# --- TLS / security (nginx terminates TLS in front of gunicorn — deploy/nginx.conf.example) ---
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_BEHIND_TLS_PROXY=1
# One year, once you are confident this host will always be served over HTTPS.
DJANGO_HSTS_SECONDS=31536000
# Both default to on once DJANGO_HSTS_SECONDS>0; set to 0/false to opt out (e.g. a subdomain
# that isn't HTTPS yet, or before submitting to browsers' HSTS preload lists).
#DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
#DJANGO_HSTS_PRELOAD=1

# --- Uploads (SPEC §3.2; keep client_max_body_size in nginx.conf.example >= server.max_upload_mb
# from settings.yaml, and DATA_UPLOAD_MAX_NUMBER_FILES generous enough for folder inputs) ---
DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=10000
# Non-multipart /api/ JSON body cap in MB, rejected fast by Content-Length (QA_FINDINGS I-4).
API_JSON_BODY_MAX_MB=10

# --- Mail fallback (the effective mail settings are settings.yaml's `mail.*`, read at send
# time by core.mail; these two are only used if code calls django.core.mail directly) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@cloudgene.example.org

# --- gunicorn (deploy/gunicorn.conf.py reads these; all optional, shown with their defaults) ---
#GUNICORN_BIND=127.0.0.1:8000
#GUNICORN_WORKERS=
#GUNICORN_THREADS=1
#GUNICORN_TIMEOUT=300
#GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Never set these in production (test/E2E only; core.checks.E001 refuses to run otherwise) ---
#INSECURE_FAST_PASSWORD_HASHING=1
#CLOUDGENE_E2E=1
